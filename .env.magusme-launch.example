# MagusMe — zero-GPU cloud (Railway/Render, no VPS)
# Merlian = Gemini (fast) or Groq.

NODE_ENV=production
PORT=3001
SERVE_CLIENT=true
TRUST_PROXY=1
CEREBELIX_V1_LAUNCH=true

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
ADMIN_SECRET=REPLACE_WITH_32_CHAR_RANDOM
CORS_ORIGIN=https://magusme.com

SQLITE_DRIVER=builtin
DATA_DIR=.data

CEREBELIX_V1_LAUNCH=true

# ── Megamind Cloud (Groq = fastest; Gemini = backup) ───────────────────────
CLOUD_NO_TRAINING_ACTIVE=true
CLOUD_FREE_DEMO=true
CLOUD_USE_GEMINI=true

# Three separate vendors (not one shared API):
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
DAGULAI_GEMINI_MODEL=gemini-2.0-flash

XAI_API_KEY=REPLACE_WITH_XAI_CONSOLE_GROK_KEY
DAGULAI_XAI_MODEL=grok-4.3

GROQ_API_KEY=REPLACE_WITH_GROQ_CONSOLE_KEY
DAGULAI_GROQ_MODEL=llama-3.1-8b-instant

# Default Merlian lane: gemini | grok | groq
ARCANA_CLOUD_PREFER=gemini
DAGULAI_CLOUD_PREFER=gemini

STARTER_TOKENS=500
BOOTSTRAP_MAX_PER_IP=50

# ── Pocket Premium & Corporate (enable when a subscriber pays) ───────────────
# Subscribers run Ollama on their device; you only document the setup URL.
# For corporate / $5k retainer — one dedicated VPS per client, point app at their private cluster:
# CORPORATE_LANE_ENABLED=true
# CORPORATE_OLLAMA_URL=https://ollama.client-acme.internal
# CORPORATE_OLLAMA_MODEL=llama3.1:70b

# Merlian / Arcana on cloud (no Ollama)
ARCANA_ENABLED=true
ARCANA_CLOUD_LLM=true

# Privacy (cloud lane — prompts go to API vendor; we minimize retention)
DAGULAI_NO_VENDOR_TRAINING=true
ARCANA_MINIMAL_LOGGING=true

# Magubrain search (main page) — free daily tier, then pay-per-search or monthly pack
ARCANA_FREE_SEARCHES_PER_DAY=5
ARCANA_SEARCH_PRICE_CENTS=100
ARCANA_MONTHLY_SEARCH_LIMIT=100
ARCANA_MONTHLY_PRICE_CENTS=900

# Bitcoin (BTCPay) — Magubrain search paywall (optional, can use PayRAM instead)
# BTCPAY_URL=https://btcpay.yourdomain.com
# BTCPAY_API_KEY_MAGUSME=
# BTCPAY_STORE_ID_MAGUSME=
# BTCPAY_WEBHOOK_SECRET_MAGUSME=
# BTCPAY_REDIRECT_URL_MAGUSME=https://magusme.com/?searchPaid=1

# PayRAM — self-hosted crypto payment gateway (primary payment processor)
# Docker: docker run -d --name payram -p 8080:8080 -p 8081:8081 payramapp/payram:latest
# API: port 8080, Admin UI: port 8081
# Get API key from PayRAM admin dashboard after signing up via Cloudflare tunnel
PAYRAM_API_KEY=
PAYRAM_BASE_URL=http://localhost:8080

VPNIX_ENABLED=false
