# MagusMe — standalone instance
# Domain: magusme.com
NODE_ENV=production
PORT=3003
SERVE_CLIENT=true
TRUST_PROXY=1

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
ADMIN_SECRET=REPLACE_WITH_32_CHAR_RANDOM
CORS_ORIGIN=https://magusme.com

SQLITE_DRIVER=builtin
DATA_DIR=.data

# Arcana/Merlian cloud lanes
ARCANA_ENABLED=true
ARCANA_CLOUD_LLM=true
ARCANA_CLOUD_PREFER=gemini

CLOUD_NO_TRAINING_ACTIVE=true
CLOUD_FREE_DEMO=false
CLOUD_USE_GEMINI=true
STARTER_TOKENS=500

GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
DAGULAI_GEMINI_MODEL=gemini-2.0-flash
XAI_API_KEY=
DAGULAI_XAI_MODEL=grok-4.3
GROQ_API_KEY=
DAGULAI_GROQ_MODEL=llama-3.1-8b-instant

DAGULAI_NO_VENDOR_TRAINING=true
ARCANA_MINIMAL_LOGGING=true

# PayRAM — self-hosted crypto payment gateway
PAYRAM_API_KEY=
PAYRAM_BASE_URL=http://localhost:8080

# Keep other products off in this instance
DAGULAI_ENABLED=false
DAGULAI_LANDING_ROOT=false
CEREBELIX_V1_LAUNCH=false
WATCH_ENABLED=false
VPNIX_ENABLED=false

# ── Live website specific configuration ───────────────────────
# Production backend URL
BACKEND_URL=https://magusme.com
# Frontend served from root
FRONTEND_ROOT=/
# CDN (if any)
CDN_URL=https://cdn.magusme.com
# Production logging
LOG_LEVEL=info
