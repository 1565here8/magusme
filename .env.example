# MagusMe Server Configuration
# Copy to .env and fill in values

PORT=3001
NODE_ENV=development

# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-256-bit-hex-secret-here

# CSRF Secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=your-128-bit-hex-secret-here

# Arcana/AI Provider (order of preference: gemini, groq, xai, openrouter)
ARCANA_CLOUD_PREFER=gemini

# AI API Keys (set at least one for AI-powered features)
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Database path (relative to project root)
DATABASE_PATH=.data/magusme.db

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Session duration in hours
SESSION_DURATION_HOURS=24

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Admin bootstrap (first-run admin creation enabled by default)
ADMIN_BOOTSTRAP_ENABLED=1

# PayRAM (crypto payment gateway)
PAYRAM_API_KEY=
PAYRAM_BASE_URL=

# Premium subscription
PREMIUM_PRICE_CENTS=2000
PREMIUM_MODEL=openai/gpt-4o-mini
PREMIUM_AI_BUDGET_CENTS=300
